{
  "name": "opencode-wallpapers",
  "version": "0.1.0",
  "description": "Animated wallpapers for the OpenCode terminal UI",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "terminal",
    "wallpaper",
    "animation",
    "opentui"
  ],
  "homepage": "https://github.com/vaprdev/opencode-wallpapers#readme",
  "bugs": {
    "url": "https://github.com/vaprdev/opencode-wallpapers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaprdev/opencode-wallpapers.git"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun dev/build.ts && bun ./node_modules/vite/bin/vite.js build",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gui.json --noEmit",
    "check": "bun dev/check.ts",
    "screenshots": "bun dev/screenshots.ts",
    "screenshots:update": "bun dev/screenshots.ts --update",
    "build:gui": "bun ./node_modules/vite/bin/vite.js build",
    "watch:gui": "bun ./node_modules/vite/bin/vite.js build --watch"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.2",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "solid-js": "1.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
